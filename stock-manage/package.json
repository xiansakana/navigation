{
  "name": "stock-manage",
  "version": "2.0.0",
  "description": "美股/A股持仓管理（navigation 子服务，纯 JS）",
  "type": "module",
  "scripts": {
    "build": "esbuild src/client/trade-table.ts --bundle --format=esm --target=es2020 --minify --legal-comments=eof --define:process.env.NODE_ENV=\\\"production\\\" --define:__VUE_OPTIONS_API__=false --define:__VUE_PROD_DEVTOOLS__=false --define:__VUE_PROD_HYDRATION_MISMATCH_DETAILS__=false --outfile=public/generated/trade-table.js",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --target ES2020 --module ESNext --moduleResolution bundler src/client/trade-table.ts",
    "prestart": "npm run build",
    "start": "node src/server.js",
    "test": "node ../scripts/test.mjs stock-manage"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "decimal.js": "10.6.0",
    "echarts": "^6.1.0",
    "esbuild": "0.28.2",
    "express": "^4.21.2",
    "pdfjs-dist": "5.6.205",
    "vue": "3.5.46",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
