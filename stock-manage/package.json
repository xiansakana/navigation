{
  "name": "stock-manage",
  "version": "1.0.0",
  "description": "美股持仓管理（portal 子服务，服务端持久化）",
  "type": "module",
  "scripts": {
    "build": "vite build && tsup server/server.ts --format esm --platform node --target node20 --outDir dist-server --no-splitting --no-minify --external vite",
    "dev": "tsx watch server/server.ts",
    "start": "NODE_ENV=production node dist-server/server.js",
    "ts-check": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
