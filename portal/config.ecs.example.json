{
  "server": {
    "host": "0.0.0.0",
    "port": 80
  },
  "auth": {
    "username": "admin",
    "password": "换成强密码",
    "sessionSecret": "换成随机字符串",
    "anonymousGuest": true,
    "guestUsername": "guest"
  },
  "oauth": {
    "defaultRoleId": "role_guest",
    "github": {
      "enabled": false,
      "clientId": "",
      "clientSecret": "",
      "redirectUri": "http://123.56.235.12/api/oauth/github/callback"
    },
    "google": {
      "enabled": false,
      "clientId": "",
      "clientSecret": "",
      "redirectUri": "http://123.56.235.12/api/oauth/google/callback"
    }
  },
  "services": [
    {
      "id": "torn-toolbox",
      "title": "Torn 工具箱",
      "description": "压价助手与公司申请监听（独立进程）",
      "type": "hub",
      "path": "/torn-toolbox",
      "entryPath": "/",
      "icon": "📊"
    },
    {
      "id": "torn-undercut",
      "title": "压价助手",
      "hidden": true,
      "type": "proxy",
      "path": "/torn-toolbox/undercut",
      "entryPath": "/",
      "internalUrl": "http://127.0.0.1:8790",
      "adminToken": "与 config.undercut.json 的 adminToken 相同",
      "icon": "📉"
    },
    {
      "id": "torn-company",
      "title": "公司监听",
      "hidden": true,
      "type": "proxy",
      "path": "/torn-toolbox/company",
      "entryPath": "/",
      "internalUrl": "http://127.0.0.1:8791",
      "adminToken": "与 config.company.json 的 adminToken 相同",
      "icon": "🏢"
    },
    {
      "id": "stock-manage",
      "title": "股票管理",
      "description": "美股持仓、交易记录与盈亏统计（服务端持久化）",
      "type": "proxy",
      "path": "/stock-manage",
      "entryPath": "/",
      "internalUrl": "http://127.0.0.1:5000",
      "injectBar": true,
      "injectBase": false,
      "icon": "📈"
    },
    {
      "id": "notes",
      "title": "笔记",
      "description": "思源笔记（SiYuan）— 块级引用、大纲、反链",
      "type": "proxy",
      "path": "/notes",
      "entryPath": "/",
      "internalUrl": "http://127.0.0.1:6806",
      "accessAuthCode": "与 siyuan/.env 的 SIYUAN_ACCESS_AUTH_CODE 相同",
      "injectBar": false,
      "injectBase": false,
      "icon": "📝"
    },
    {
      "id": "siyuan-share",
      "title": "笔记分享",
      "description": "思源笔记公开分享与 API Key 管理",
      "type": "proxy",
      "path": "/share",
      "entryPath": "/dashboard",
      "internalUrl": "http://127.0.0.1:6807",
      "injectBar": false,
      "injectBase": true,
      "icon": "🔗"
    },
    {
      "id": "napcat",
      "title": "NapCat 管理",
      "description": "QQ 机器人 WebUI（网络配置、登录状态）",
      "type": "proxy",
      "path": "/napcat",
      "entryPath": "/webui",
      "internalUrl": "http://127.0.0.1:6099",
      "adminToken": "NapCat WebUI token（webui.json）",
      "injectBar": false,
      "injectBase": false,
      "icon": "💬"
    }
  ]
}
