{
  "napcat": {
    "baseUrl": "http://127.0.0.1:3000",
    "accessToken": "",
    "watchdog": {
      "enabled": false,
      "intervalMs": 60000,
      "failBeforeRestart": 2,
      "cooldownMs": 600000,
      "restartCommand": ["docker", "restart", "napcat"]
    }
  },
  "defaultTarget": {
    "type": "group",
    "groupId": "123456789",
    "atUserId": "987654321"
  },
  "channels": {
    "qq": {
      "enabled": true
    },
    "email": {
      "enabled": false,
      "from": "通知中心 <name@example.com>",
      "to": "you@example.com",
      "smtp": {
        "host": "smtp.example.com",
        "port": 465,
        "secure": true,
        "user": "name@example.com",
        "pass": "填写 SMTP 密码或授权码"
      }
    }
  },
  "monitors": {
    "tiboReset": {
      "enabled": false,
      "intervalMinutes": 5,
      "feedUrl": "https://codex-reset.com/api/feed",
      "rssUrl": "https://x.noodl3.net/thsottiaux/rss"
    }
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "notifyToken": "change-me-to-a-long-random-string"
  }
