# 复制为 tokens.env 后填入（勿提交 Git）
# 获取链接见下方注释；只需 refresh_token 的项留空 client 即可用官方默认

# 阿里云盘 Open — https://alistgo.com/tool/aliyundrive/request
# （或文档：https://alistgo.com/guide/drivers/aliyundrive_open.html）
ALIYUN_REFRESH_TOKEN=

# 百度网盘 — https://alistgo.com/tool/baidu/request
BAIDU_REFRESH_TOKEN=

# OneDrive — https://alistgo.com/tool/onedrive/request
# 该页会同时给出 client_id / client_secret / refresh_token
ONEDRIVE_REFRESH_TOKEN=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REGION=global

# Google Drive — https://alistgo.com/tool/google/request
GOOGLE_REFRESH_TOKEN=

# 115 开放平台 — https://alistgo.com/tool/115/request
# （文档：https://alistgo.com/zh/guide/drivers/115_open.html）
OPEN115_REFRESH_TOKEN=
